print("   4. Retrain model monthly with new customer data")

# %% [markdown]
# ### 12. Conclusion

# %%
print("\n" + "="*60)
print("✅ FINAL CONCLUSION")
print("="*60)

print(f"\n🏆 BEST MODEL: {best_model}")
print(f"📊 Best Accuracy: {best_accuracy:.4f} ({best_accuracy*100:.2f}%)")
print(f"🎯 Best ROC-AUC: {max(lr_auc, rf_auc):.4f}")
print(f"📈 Best F1-Score: {max(lr_f1, rf_f1):.4f}")

print("\n✅ RECOMMENDATION:")
print(f"   Deploy {best_model} to production for customer churn prediction.")
print("   The model is interpretable, efficient, and provides actionable insights.")

